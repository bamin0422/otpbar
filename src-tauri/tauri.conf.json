{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OTPBar",
  "version": "2.0.0",
  "identifier": "com.bamin0422.otpbar",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OTPBar",
        "width": 440,
        "height": 660,
        "minWidth": 380,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "visible": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "메뉴바·트레이 OTP 클라이언트",
    "longDescription": "구글 OTP(Google Authenticator)에 등록한 계정의 일회용 코드를 메뉴바·트레이에서 바로 쓰는 도구. 비밀키는 마스터 암호로 암호화한 금고에 보관한다.",
    "category": "Utility",
    "copyright": "© 2026 bamin0422. MIT License.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVBQzhEMzlDMEZBQjgzODkKUldTSmc2c1BuTlBJNmd1YkJmMERNOGpERTN0VUFBVm9QaUJNeVN1TFpIUi9YSjhNOUo3NjJKQjAK",
      "endpoints": [
        "https://github.com/bamin0422/otpbar/releases/latest/download/latest.json"
      ]
    }
  }
}
