def notify(title: str, subtitle: str, message: str) -> None:
    try:
        if IS_MAC:
            script = ['on run argv',
                      'display notification (item 1 of argv) with title (item 2 of argv) subtitle (item 3 of argv) sound name "Pop"',
                      'end run']
            args = [OSASCRIPT]
            for line in script:
                args += ["-e", line]
            subprocess.run(args + [message, title, subtitle], capture_output=True)
        elif IS_WIN:
            env = dict(os.environ, OTPBAR_TITLE=f"{title} · {subtitle}" if subtitle else title, OTPBAR_MSG=message)
            subprocess.run([POWERSHELL, "-NoProfile", "-NonInteractive", "-WindowStyle", "Hidden", "-Command", _TOAST_PS],
                           capture_output=True, env=env, creationflags=NO_WINDOW)
        elif shutil.which("notify-send"):
            subprocess.run(["notify-send", f"{title} · {subtitle}" if subtitle else title, message], capture_output=True)
    except Exception as e:  # 알림 실패는 치명적이지 않다
        print(f"(알림 실패: {e})", file=sys.stderr)


def copy_clipboard(text: str, clear_after: int | None = None) -> None:
    """클립보드에 복사한다. clear_after(초)가 주어지면 그 뒤에도 같은 값이면 자동으로 지운다(분리 프로세스)."""
    if IS_MAC:
        subprocess.run([PBCOPY], input=text, text=True, check=False)
    elif IS_WIN:
        subprocess.run([CLIP], input=text, text=True, check=False, creationflags=NO_WINDOW)
    elif shutil.which("wl-copy"):
        subprocess.run(["wl-copy"], input=text, text=True, check=False)
    elif shutil.which("xclip"):
        subprocess.run(["xclip", "-selection", "clipboard"], input=text, text=True, check=False)
    else:
        print("(클립보드 도구가 없습니다: wl-copy 또는 xclip 필요)", file=sys.stderr)
        return
    if clear_after:
        _schedule_clipboard_clear(text, int(clear_after))


def _schedule_clipboard_clear(text: str, seconds: int) -> None:
    """코드 만료 뒤 클립보드가 여전히 그 코드면 비운다. 숫자 코드만 다루므로 셸 인용이 안전하다."""
    if not re.fullmatch(r"[0-9]{4,10}", text):
        return
    quiet = dict(stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        if IS_MAC:  # 값은 셸 문자열이 아니라 위치 인자($1,$2)로 넘긴다
            sh = f'sleep "$1"; [ "$({PBPASTE})" = "$2" ] && printf "" | {PBCOPY}'
            subprocess.Popen(["/bin/sh", "-c", sh, "otpbar-clear", str(seconds), text], start_new_session=True, **quiet)
        elif IS_WIN:
            ps = ("Add-Type -AssemblyName System.Windows.Forms; Start-Sleep ([int]$env:OTPBAR_WAIT); "
                  "if ([System.Windows.Forms.Clipboard]::GetText() -eq $env:OTPBAR_CODE) { [System.Windows.Forms.Clipboard]::Clear() }")
            env = dict(os.environ, OTPBAR_WAIT=str(seconds), OTPBAR_CODE=text)
            subprocess.Popen([POWERSHELL, "-STA", "-NoProfile", "-NonInteractive", "-WindowStyle", "Hidden", "-Command", ps],
                             creationflags=NO_WINDOW | getattr(subprocess, "DETACHED_PROCESS", 0), env=env, **quiet)
        elif shutil.which("wl-copy"):
            sh = 'sleep "$1"; [ "$(wl-paste -n 2>/dev/null)" = "$2" ] && wl-copy --clear'
            subprocess.Popen(["/bin/sh", "-c", sh, "otpbar-clear", str(seconds), text], start_new_session=True, **quiet)
        elif shutil.which("xclip"):
            sh = 'sleep "$1"; [ "$(xclip -selection clipboard -o 2>/dev/null)" = "$2" ] && printf "" | xclip -selection clipboard'
            subprocess.Popen(["/bin/sh", "-c", sh, "otpbar-clear", str(seconds), text], start_new_session=True, **quiet)
    except Exception:
        pass


